# ==============================================================================
# 創進一號 (Forerunner 1 / F1) 本地端 SSH 設定範本
# 請將本內容加入至您「個人本機電腦」的 ~/.ssh/config 檔案中 (若檔案不存在請自行建立)
# 建立後即可在本地終端機直接輸入：ssh f1
# ==============================================================================

# X86 架構登入節點 01 (預設推薦)
Host f1
    HostName f1-ilgn01.nchc.org.tw
    User YOUR_ISERVICE_ACCOUNT
    Port 22
    ServerAliveInterval 60
    ServerAliveCountMax 3

# X86 架構登入節點 02 (備援)
Host f1-02
    HostName f1-ilgn02.nchc.org.tw
    User YOUR_ISERVICE_ACCOUNT
    Port 22
    ServerAliveInterval 60
    ServerAliveCountMax 3

# 高速資料傳輸節點 (DTN 01) - 專供 SFTP / SCP 大檔案傳輸使用
Host f1-dtn
    HostName f1-dtn01.nchc.org.tw
    User YOUR_ISERVICE_ACCOUNT
    Port 22
    ServerAliveInterval 60
    ServerAliveCountMax 3

# 高速資料傳輸節點 (DTN 02 備援)
Host f1-dtn-02
    HostName f1-dtn02.nchc.org.tw
    User YOUR_ISERVICE_ACCOUNT
    Port 22
    ServerAliveInterval 60
    ServerAliveCountMax 3

# ARM 架構登入節點 01 (如有使用 ARM 分區需求)
Host f1-arm
    HostName f1-nlgn01.nchc.org.tw
    User YOUR_ISERVICE_ACCOUNT
    Port 22
    ServerAliveInterval 60
    ServerAliveCountMax 3

# ARM 架構登入節點 02 (備援)
Host f1-arm-02
    HostName f1-nlgn02.nchc.org.tw
    User YOUR_ISERVICE_ACCOUNT
    Port 22
    ServerAliveInterval 60
    ServerAliveCountMax 3
