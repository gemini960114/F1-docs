#!/bin/bash
# ==============================================================================
# Slurm 批次排程範本：單節點多執行緒運算 (Single-Node Multi-Threading)
# 適用於：Python (multiprocessing)、R、FastQC、BWA、Samtools 等常規科研計算
# ==============================================================================
#SBATCH --account=GOV114022                  # 必填：wallet 查詢之可用計畫代號 (PROJECT_ID)
#SBATCH --job-name=cpu_task                  # 作業識別名稱
#SBATCH --partition=ct112                    # 登入節點推薦佇列：ct112 (標準) 或 development (除錯)
#SBATCH --nodes=1                            # 單節點運算
#SBATCH --ntasks-per-node=1                  # 節點內主行程數
#SBATCH --cpus-per-task=4                    # 分配 CPU 核心數 (ct112 每核自動獲得 ~4.3 GB RAM)
#SBATCH --time=04:00:00                      # 作業最長時限 (D-HH:MM:SS)
#SBATCH --output=%x-%j.out                   # 標準輸出 (%x:作業名, %j:作業ID)
#SBATCH --error=%x-%j.err                    # 標準錯誤
#SBATCH --mail-type=END,FAIL                 # 通知時機 (NONE / BEGIN / END / FAIL / ALL)
#SBATCH --mail-user=user@example.com         # 接收通報之 Email

# ------------------------------------------------------------------------------
# 嚴格安全與環境設定
# ------------------------------------------------------------------------------
set -e                                       # 任一步驟失敗即停止，避免無效運算空轉
set -o pipefail                              # 管道命令中若有失敗視為整體失敗

echo "================================================================================"
echo "作業啟動時間 : $(date)"
echo "執行計算節點 : $(hostname -s)"
echo "作業任務 ID  : ${SLURM_JOB_ID}"
echo "分配 CPU 核心: ${SLURM_CPUS_PER_TASK}"
echo "分配記憶體   : 約 $(( SLURM_CPUS_PER_TASK * 4308 / 1024 )) GB"
echo "工作目錄     : $(pwd)"
echo "================================================================================"

# ------------------------------------------------------------------------------
# 載入運算環境與模組
# ------------------------------------------------------------------------------
# 載入系統模組 (範例: module load biology/bwa/0.7.17)
# 或啟用虛擬環境 (建議建立於高速 /work1 儲存區):
# source /work1/$USER/my_env/bin/activate

# ------------------------------------------------------------------------------
# 執行核心運算任務
# ------------------------------------------------------------------------------
# 提示：將腳本內部執行緒參數綁定至 ${SLURM_CPUS_PER_TASK}
# python3 my_script.py --threads ${SLURM_CPUS_PER_TASK}

echo "================================================================================"
echo "作業完成時間 : $(date)"
echo "================================================================================"
